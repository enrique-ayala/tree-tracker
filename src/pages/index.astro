---
import Layout from '../components/Layout.astro';
import TreeCard from '../components/TreeCard.astro';

// Load all markdown files from /trees
const treeEntries = await Astro.glob('../trees/*.md');
---

<Layout>
  <h1>My Trees</h1>
  <div style="display: grid; gap: 1rem;">
    {treeEntries.map(tree => <TreeCard {...tree.frontmatter} />)}
  </div>
</Layout>
