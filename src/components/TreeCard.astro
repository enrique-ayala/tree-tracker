---
const { name, species, plantDate, updates } = Astro.props;
---

<div class="tree-card">
  <h2>{name}</h2>
  <p><strong>Species:</strong> {species}</p>
  <p><strong>Planted:</strong> {plantDate}</p>

  <h3>Progress updates</h3>
  <ul class="tree-updates">
    {updates.map(update => (
      <li>
        <p><strong>{update.date}</strong> - {update.title}</p>
        {update.image && (
          <a href={update.image} target="_blank" rel="noopener noreferrer">
            <img src={update.image} alt={update.title} width="200" style="border-radius: 8px; cursor: pointer;" />
          </a>
        )}
        <p><em>Height:</em> {update.height_cm} cm</p>
        <p><em>Weather:</em> {update.weather}</p>
        <p>{update.notes}</p>
      </li>
    ))}
  </ul>
</div>
