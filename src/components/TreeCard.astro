---
const { name, species, plantDate, updates } = Astro.props;

// Calculate tree age based on last update date
const getTreeAge = (plantDate, updates) => {
  const planted = new Date(plantDate);
  const lastUpdate = updates && updates.length > 0 ? new Date(updates[0].date) : new Date();
  const ageInYears = (lastUpdate - planted) / (1000 * 60 * 60 * 24 * 365.25);
  return ageInYears.toFixed(1);
};

const age = getTreeAge(plantDate, updates);
---

<div class="tree-card">
  <h2>{name}</h2>
  <p><strong>Species:</strong> {species}</p>
  <p><strong>Planted:</strong> {plantDate} ({age} years old)</p>

  <h3>Progress updates</h3>
  <ul class="tree-updates">
    {updates.map(update => (
      <li>
        <p><strong>{update.date}</strong> - {update.title}</p>
        {update.image && (
          <a href={update.image} target="_blank" rel="noopener noreferrer">
            <img src={update.image} alt={update.title} width="200" style="border-radius: 8px; cursor: pointer;" />
          </a>
        )}
        <p><em>Height:</em> {update.height_cm} cm</p>
        <p><em>Weather:</em> {update.weather}</p>
        <p>{update.notes}</p>
      </li>
    ))}
  </ul>
</div>
